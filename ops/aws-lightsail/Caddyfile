{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:8080
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8080
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
}
