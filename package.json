{
  "name": "bukky-booking-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "ci": "pnpm ci:format && pnpm ci:lint && pnpm ci:typecheck && pnpm ci:test:unit && pnpm ci:build",
    "ci:build": "pnpm ci:build:backend && pnpm ci:build:frontend",
    "ci:build:backend": "pnpm --filter booking-system build",
    "ci:build:frontend": "pnpm --filter booking-system-frontend build",
    "ci:format": "pnpm format:check",
    "ci:lint": "pnpm ci:lint:backend && pnpm ci:lint:frontend",
    "ci:lint:backend": "pnpm --filter booking-system lint",
    "ci:lint:frontend": "pnpm --filter booking-system-frontend lint",
    "ci:test:e2e:backend": "pnpm --filter booking-system test:e2e -- app.e2e-spec.ts",
    "ci:test:integration:backend": "pnpm --filter booking-system test:e2e -- booking-concurrency.e2e-spec.ts",
    "ci:test:unit": "pnpm ci:test:unit:backend && pnpm ci:test:unit:frontend",
    "ci:test:unit:backend": "pnpm --filter booking-system test:ci",
    "ci:test:unit:frontend": "pnpm --filter booking-system-frontend test:ci",
    "ci:typecheck": "pnpm ci:typecheck:backend && pnpm ci:typecheck:frontend",
    "ci:typecheck:backend": "pnpm --filter booking-system typecheck",
    "ci:typecheck:frontend": "pnpm --filter booking-system-frontend typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "test": "pnpm -r --if-present test:ci",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "@sentry/cli",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": "2.2.0",
      "typeorm": "0.3.29",
      "path-to-regexp": "8.4.0",
      "qs": "6.15.2",
      "fast-xml-parser": "5.7.0",
      "fast-xml-builder": "1.1.7",
      "lodash": "4.18.0",
      "tmp": "0.2.7",
      "file-type": "21.3.2",
      "brace-expansion@<2.0.0": "1.1.13",
      "brace-expansion@>=2.0.0 <3.0.0": "2.0.3",
      "uuid": "11.1.1",
      "postcss": "8.5.15"
    }
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
