# Compose and release
APP_DOMAIN=bukky.example.com
API_DOMAIN=api.bukky.example.com
ACME_EMAIL=ops@example.com
BACKEND_IMAGE=ghcr.io/owner/bukky-backend
BACKEND_OPERATIONS_IMAGE=ghcr.io/owner/bukky-backend-operations
FRONTEND_IMAGE=ghcr.io/owner/bukky-frontend
RELEASE_SHA=replace-with-a-git-sha
BACKEND_APP_ROLE=all
# To split API and worker later:
# BACKEND_APP_ROLE=api
# COMPOSE_PROFILES=worker

# Application
NODE_ENV=production
APP_PUBLIC_URL=https://bukky.example.com
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://bukky.example.com
CORS_ALLOW_CREDENTIALS=true
DB_HOST=postgres
DB_PORT=5432
DB_USER=bukky
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=bukky
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

# Authentication
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_REFRESH_EXPIRES_IN=30d
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
MFA_CHALLENGE_SECRET=replace-with-a-different-random-secret
MFA_ISSUER=Bukky
AUTH_REFRESH_COOKIE_NAME=bukky_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_DOMAIN=api.bukky.example.com
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_CSRF_COOKIE_NAME=bukky_csrf
AUTH_CSRF_COOKIE_DOMAIN=bukky.example.com
AUTH_CSRF_COOKIE_PATH=/
AUTH_CSRF_HEADER_NAME=x-csrf-token

# Bot protection
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret
TURNSTILE_EXPECTED_HOSTNAME=bukky.example.com

# S3 public assets
AWS_REGION=us-east-1
AWS_S3_BUCKET=bukky-public-assets-293968602385
AWS_S3_PUBLIC_BASE_URL=https://bukky-public-assets-293968602385.s3.us-east-1.amazonaws.com
AWS_ACCESS_KEY_ID=replace-with-limited-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-limited-iam-secret
AWS_S3_FORCE_PATH_STYLE=false

# Email
MAIL_ENABLED=true
MAIL_FROM_EMAIL=notifications@example.com
MAIL_FROM_NAME=Bukky Booking
MAIL_REPLY_TO_EMAIL=support@example.com
RESEND_API_KEY=replace-with-resend-key

# Reminders
REMINDERS_ENABLED=true
REMINDERS_SCHEDULER_ENABLED=true
REMINDERS_TIMEZONE=Europe/Madrid
REMINDERS_DISPATCH_HOUR=17
REMINDERS_DISPATCH_MINUTE=0
REMINDERS_BATCH_SIZE=25
REMINDERS_MAX_ATTEMPTS=3
REMINDERS_RETRY_DELAY_MINUTES=15
REMINDERS_PROCESSING_STALE_MINUTES=10

# Observability
PERFORMANCE_LOG_ENABLED=true
PERFORMANCE_SLOW_REQUEST_MS=750

# Backup destination used by backup-postgres.sh
BACKUP_S3_URI=s3://bukky-backups-293968602385/postgres
BACKUP_RETENTION_DAYS=30
